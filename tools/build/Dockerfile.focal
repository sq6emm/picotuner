# Ubuntu 20.04 apt toolchain (arm-none-eabi-gcc 9.2.1, 9-2019-q4): links the PicoTunerWH
# source without -fcommon, as the BATC wiki's "sudo apt install gcc-arm-none-eabi" implies.
FROM ubuntu:20.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends gcc-arm-none-eabi libnewlib-arm-none-eabi libstdc++-arm-none-eabi-newlib cmake make python3 g++ git ca-certificates && rm -rf /var/lib/apt/lists/*
